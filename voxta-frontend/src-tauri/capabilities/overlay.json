{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "The floating overlay can move, close itself and talk to the main window. It has no network or file access.",
  "windows": ["overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus"
  ]
}