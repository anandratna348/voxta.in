{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Voxta main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-write-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:8765/*" },
        { "url": "http://localhost:8765/*" }
      ]
    }
  ]
}