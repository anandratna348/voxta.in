# Public, non-secret configuration only. Never put API keys here.
# Anything prefixed with VITE_ is bundled into the app and visible to users.

# Local Voxta backend
VITE_API_BASE_URL=http://127.0.0.1:8765/api/v1
VITE_BACKEND_ORIGIN=http://127.0.0.1:8765
VITE_USE_DEV_PROXY=true
VITE_HEALTH_POLL_MS=15000

# License server (see LICENSE_API.md). For testing: node tools/mock-license-server.mjs --write-env
VITE_LICENSE_API_URL=
# Raw Ed25519 public key, base64url. It only verifies signatures, so it is not a secret.
VITE_LICENSE_PUBLIC_KEY=
# Optional: page that shows plans, opened from the activation screen
VITE_PURCHASE_URL=